# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 삭제 대기 폴더 (사용자가 확인 후 직접 삭제)
/trash-can/

# 손 점검용 사진 (사람이 나오므로 커밋 금지)
/test-photos/

# 값이 비어 있는 예시 파일만 올린다 (진짜 키가 든 .env는 계속 제외)
!.env.example

# 도구 설정 폴더 (공개 저장소에 올리지 않음)
/.claude/
/.bkit/
